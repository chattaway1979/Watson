# ============================================================
# Watson — H&R AI IT Agent : Environment Configuration
# ============================================================
# Copy to .env.local for local development. All defaults are SAFE.
# NEVER put real secrets in this file or commit them. Secrets come from
# Azure Key Vault at runtime (see Microsoft Graph section below).

# --- AUTHENTICATION MODE ------------------------------------
# "demo"  (default) — local dev & automated tests ONLY. Identity comes from the
#                     watson_role cookie / X-Watson-Role header role switcher.
#                     NOT for production.
# "entra"           — production. Identity comes ONLY from the platform-verified
#                     Entra session (Azure App Service Authentication / Easy Auth
#                     `x-ms-client-principal`). Client role headers/cookies are
#                     ignored. REQUIRES deployment behind the platform auth gate.
# There is no silent fallback: pick the mode explicitly. See docs/PILOT_RUNBOOK.md.
WATSON_AUTH_MODE=demo
# Admin authorization (entra mode) — grant admin via ONE of these. Values are
# NOT secrets, but are tenant-specific; use real values only in deployment env.
# WATSON_ADMIN_ENTRA_GROUP_ID=<entra-security-group-object-id>
# WATSON_ADMIN_APP_ROLE=<app-role-value-e.g.-Watson.Admin>
# Auth.js/NextAuth (optional alternative provider) session secret — SECRET,
# server-only, never exposed to the browser. Only needed if you wire NextAuth
# instead of App Service Authentication.
# AUTH_SECRET=<generate-a-random-secret>
# Entra login app (only if wiring NextAuth rather than Easy Auth) — the ID/issuer
# are not secrets; the client secret is (keep it in Key Vault or platform config):
# AUTH_MICROSOFT_ENTRA_ID_ID=<login-app-client-id>
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# --- WATSON APPLICATION ROLES (RBAC) ------------------------
# The FIRST Watson role administrator is created only from server configuration.
# There is no first-user-wins, no default administrator, and no request header,
# cookie, query string or body that can trigger it. Bootstrap is a no-op the
# moment any active role administrator exists.
#
# Must be a well-formed immutable Entra object id (GUID). An email address, a
# display name or a malformed value is REFUSED, never normalised into something
# usable. Set this in the deployment environment, not in a committed file.
# WATSON_RBAC_BOOTSTRAP_OID=<entra-object-id-of-the-first-role-administrator>
#
# --- LOCAL BROWSER VALIDATION ONLY (production-inert) -------
# Easy Auth does not exist on a developer machine, so there is no principal to
# resolve and the administrator UI cannot be exercised in a browser. These supply
# a SYNTHETIC one. They are ignored entirely when NODE_ENV=production, they have
# no default, and they must still be a well-formed object id.
#
# Supported local configuration (PowerShell, same process as `npm run dev`):
#   $env:WATSON_LOCAL_TEST_OID   = "00000000-0000-0000-0000-000000000777"
#   $env:WATSON_RBAC_BOOTSTRAP_OID = "00000000-0000-0000-0000-000000000777"
#   npm run dev
#
# Both values must be the SAME object id: bootstrap grants the role to
# WATSON_RBAC_BOOTSTRAP_OID, and the local seam signs you in as
# WATSON_LOCAL_TEST_OID. If they differ, the browser actor is correctly refused.
#
# STORE HYGIENE: bootstrap no-ops when the local JSON store at
# data/watson-store.json already holds an ACTIVE watson_role_admin. If local
# bootstrap reports `persistent_admin_exists` (the reason is printed once per
# process as `[watson][rbac] bootstrap outcome: ...`), that store already has an
# administrator. To start clean, delete data/watson-store.json, or point the run
# at its own store with WATSON_DATA_DIR. The self-test suite never writes here.
# WATSON_LOCAL_TEST_OID=
# WATSON_LOCAL_TEST_UPN=local.test@staged.invalid
# WATSON_LOCAL_TEST_NAME=Local Test Administrator

# --- LOCAL JSON STORE ---------------------------------------
# WATSON_DATA_DIR=<writable-dir>   (default: <cwd>/data)
# IT_AGENT_PERSIST=off             disables all store writes (tests/self-test)

# --- SAFETY MASTER SWITCH -----------------------------------
# Live external EXECUTION (writes / tenant-changing IT actions). MUST remain
# false in this build. When false, every risky/critical action runs in MOCK
# mode or is queued for human approval. This is independent of the Graph
# read-only flag below — read-only Graph is NOT execution.
IT_AGENT_LIVE_EXTERNAL_EXECUTION=false

# Operating mode banner shown to admins. "mock" | "live" (live unsupported in this build)
IT_AGENT_MODE=mock

# --- AI PROVIDER (optional) ---------------------------------
# If unset, Watson uses the deterministic rule-based agent (no network, no key needed).
# Supported (future): "anthropic" | "azure-openai" | "openai"
AI_PROVIDER=deterministic
# AI_API_KEY=
# AI_MODEL=
# AZURE_OPENAI_ENDPOINT=

# --- DATABASE (future production) ---------------------------
# Local dev uses a JSON file store (no DB needed). Production target: Azure Postgres / Azure SQL.
# DATABASE_URL=postgresql://user:pass@host:5432/watson

# --- MICROSOFT GRAPH (READ-ONLY, DISABLED BY DEFAULT) -------
# CREDENTIAL MODEL (011B): the Azure App Service SYSTEM-ASSIGNED MANAGED IDENTITY
# is the sole Graph credential. There is NO client secret, NO certificate, and NO
# Key Vault dependency. Nothing below is a credential — do not add one.
#
# Read-only Graph is OFF unless ALL of the following are true at runtime (the
# production bootstrap enforces this and otherwise fails closed — never to a
# fabricated "live"):
#   1) IT_AGENT_GRAPH_LIVE_READONLY=true
#   2) The host has a managed identity that can mint a Graph token
#   3) That identity holds exactly the approved read-only Graph app roles:
#      User.Read.All, UserAuthenticationMethod.Read.All, MailboxSettings.Read
#   4) The Graph HTTP transport assembles successfully
# See docs/GRAPH_MANAGED_IDENTITY_011B.md (current) and
#     docs/GRAPH_LIVE_READONLY.md (legacy runbook).
IT_AGENT_GRAPH_LIVE_READONLY=false
# Optional, non-secret:
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
#
# NEVER SET THESE. A Graph client secret in configuration is treated as a POSTURE
# FAILURE by graphClientSecretPosture(), not as a fallback credential:
#   GRAPH_CLIENT_SECRET / AZURE_CLIENT_SECRET
#
# --- LEGACY (011A) — inert under the managed-identity model -------------------
# These were the client-credentials settings. They are no longer read on the
# production path and name a secret that does not exist. Safe to remove.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# AZURE_KEY_VAULT_URL=https://<your-vault>.vault.azure.net
# GRAPH_CLIENT_SECRET_KEYVAULT_REF=watson-graph-client-secret
# Optional: user-assigned managed identity client id for Key Vault access.
# Leave unset to use the system-assigned / workload identity. This is NOT the
# Graph app (GRAPH_CLIENT_ID) and is NOT a secret.
# AZURE_MANAGED_IDENTITY_CLIENT_ID=

# --- OTHER FUTURE INTEGRATIONS (all disabled in this build) -
# INTUNE_ENABLED=false
# NINJAONE_ENABLED=false
# ATERA_ENABLED=false
