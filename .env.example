# ============================================================
# Watson — H&R AI IT Agent : Environment Configuration
# ============================================================
# Copy to .env.local for local development. All defaults are SAFE.

# --- SAFETY MASTER SWITCH -----------------------------------
# Live external execution of real IT actions. MUST remain false in this build.
# When false, every external/risky action runs in MOCK mode or is queued for approval.
IT_AGENT_LIVE_EXTERNAL_EXECUTION=false

# Operating mode banner shown to admins. "mock" | "live" (live unsupported in this build)
IT_AGENT_MODE=mock

# --- AI PROVIDER (optional) ---------------------------------
# If unset, Watson uses the deterministic rule-based agent (no network, no key needed).
# Supported (future): "anthropic" | "azure-openai" | "openai"
AI_PROVIDER=deterministic
# AI_API_KEY=
# AI_MODEL=
# AZURE_OPENAI_ENDPOINT=

# --- DATABASE (future production) ---------------------------
# Local dev uses a JSON file store (no DB needed). Production target: Azure Postgres / Azure SQL.
# DATABASE_URL=postgresql://user:pass@host:5432/watson

# --- FUTURE INTEGRATIONS (all disabled in this build) -------
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# INTUNE_ENABLED=false
# NINJAONE_ENABLED=false
# ATERA_ENABLED=false

# --- LOCAL WINDOWS TEST-DEVICE ADAPTER (real path, DISABLED by default) ---
# The local adapter fails closed unless BOTH of these are set AND a valid
# non-production marker file (nonProduction:true) exists. Never enable on a
# production/employee computer. Template: docs/watson-nonprod-testdevice.marker.example.json
WATSON_LOCAL_ENDPOINT_ENABLED=false
WATSON_LOCAL_TESTDEVICE_MARKER=C:\watson-nonprod-testdevice.marker
