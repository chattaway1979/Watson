# ============================================================
# Watson — H&R AI IT Agent : Environment Configuration
# ============================================================
# Copy to .env.local for local development. All defaults are SAFE.
# NEVER put real secrets in this file or commit them. Secrets come from
# Azure Key Vault at runtime (see Microsoft Graph section below).

# --- SAFETY MASTER SWITCH -----------------------------------
# Live external EXECUTION (writes / tenant-changing IT actions). MUST remain
# false in this build. When false, every risky/critical action runs in MOCK
# mode or is queued for human approval. This is independent of the Graph
# read-only flag below — read-only Graph is NOT execution.
IT_AGENT_LIVE_EXTERNAL_EXECUTION=false

# Operating mode banner shown to admins. "mock" | "live" (live unsupported in this build)
IT_AGENT_MODE=mock

# --- AI PROVIDER (optional) ---------------------------------
# If unset, Watson uses the deterministic rule-based agent (no network, no key needed).
# Supported (future): "anthropic" | "azure-openai" | "openai"
AI_PROVIDER=deterministic
# AI_API_KEY=
# AI_MODEL=
# AZURE_OPENAI_ENDPOINT=

# --- DATABASE (future production) ---------------------------
# Local dev uses a JSON file store (no DB needed). Production target: Azure Postgres / Azure SQL.
# DATABASE_URL=postgresql://user:pass@host:5432/watson

# --- MICROSOFT GRAPH (READ-ONLY, DISABLED BY DEFAULT) -------
# Read-only Graph is OFF unless ALL of the following are true at runtime:
#   1) IT_AGENT_GRAPH_LIVE_READONLY=true
#   2) GRAPH_TENANT_ID / GRAPH_CLIENT_ID / GRAPH_CLIENT_SECRET_KEYVAULT_REF are set
#   3) The client secret is resolved from Azure Key Vault by an injected provider
#   4) A real Graph HTTP client is supplied by the app bootstrap
# Otherwise the app falls back to the MOCK read-only connector (the default).
IT_AGENT_GRAPH_LIVE_READONLY=false
# Non-secret identifiers (safe to set; these are NOT secrets):
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# --- Azure Key Vault (secret stays in the vault; only a REFERENCE lives here) ---
# The client SECRET value is NEVER stored in env or source. Provide only the
# Key Vault URL and the secret's REFERENCE name/URI; the value is fetched at runtime.
# AZURE_KEY_VAULT_URL=https://<your-vault>.vault.azure.net
# GRAPH_CLIENT_SECRET_KEYVAULT_REF=watson-graph-client-secret

# --- OTHER FUTURE INTEGRATIONS (all disabled in this build) -
# INTUNE_ENABLED=false
# NINJAONE_ENABLED=false
# ATERA_ENABLED=false
