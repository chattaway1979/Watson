# ============================================================
# Watson — H&R AI IT Agent : Environment Configuration
# ============================================================
# Copy to .env.local for local development. All defaults are SAFE.
# NEVER put real secrets in this file or commit them. Secrets come from
# Azure Key Vault at runtime (see Microsoft Graph section below).

# --- AUTHENTICATION MODE ------------------------------------
# "demo"  (default) — local dev & automated tests ONLY. Identity comes from the
#                     watson_role cookie / X-Watson-Role header role switcher.
#                     NOT for production.
# "entra"           — production. Identity comes ONLY from the platform-verified
#                     Entra session (Azure App Service Authentication / Easy Auth
#                     `x-ms-client-principal`). Client role headers/cookies are
#                     ignored. REQUIRES deployment behind the platform auth gate.
# There is no silent fallback: pick the mode explicitly. See docs/PILOT_RUNBOOK.md.
WATSON_AUTH_MODE=demo
# Admin authorization (entra mode) — grant admin via ONE of these. Values are
# NOT secrets, but are tenant-specific; use real values only in deployment env.
# WATSON_ADMIN_ENTRA_GROUP_ID=<entra-security-group-object-id>
# WATSON_ADMIN_APP_ROLE=<app-role-value-e.g.-Watson.Admin>
# Auth.js/NextAuth (optional alternative provider) session secret — SECRET,
# server-only, never exposed to the browser. Only needed if you wire NextAuth
# instead of App Service Authentication.
# AUTH_SECRET=<generate-a-random-secret>
# Entra login app (only if wiring NextAuth rather than Easy Auth) — the ID/issuer
# are not secrets; the client secret is (keep it in Key Vault or platform config):
# AUTH_MICROSOFT_ENTRA_ID_ID=<login-app-client-id>
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# --- SAFETY MASTER SWITCH -----------------------------------
# Live external EXECUTION (writes / tenant-changing IT actions). MUST remain
# false in this build. When false, every risky/critical action runs in MOCK
# mode or is queued for human approval. This is independent of the Graph
# read-only flag below — read-only Graph is NOT execution.
IT_AGENT_LIVE_EXTERNAL_EXECUTION=false

# Operating mode banner shown to admins. "mock" | "live" (live unsupported in this build)
IT_AGENT_MODE=mock

# --- AI PROVIDER (optional) ---------------------------------
# If unset, Watson uses the deterministic rule-based agent (no network, no key needed).
# Supported (future): "anthropic" | "azure-openai" | "openai"
AI_PROVIDER=deterministic
# AI_API_KEY=
# AI_MODEL=
# AZURE_OPENAI_ENDPOINT=

# --- DATABASE (future production) ---------------------------
# Local dev uses a JSON file store (no DB needed). Production target: Azure Postgres / Azure SQL.
# DATABASE_URL=postgresql://user:pass@host:5432/watson

# --- MICROSOFT GRAPH (READ-ONLY, DISABLED BY DEFAULT) -------
# Read-only Graph is OFF unless ALL of the following are true at runtime (the
# production bootstrap enforces this and otherwise fails closed to MOCK):
#   1) IT_AGENT_GRAPH_LIVE_READONLY=true
#   2) GRAPH_TENANT_ID / GRAPH_CLIENT_ID / GRAPH_CLIENT_SECRET_KEYVAULT_REF are set
#   3) AZURE_KEY_VAULT_URL is set and the managed identity can read the secret
#   4) The client secret resolves (non-empty) from Azure Key Vault
#   5) The Graph HTTP transport assembles successfully
# See docs/GRAPH_LIVE_READONLY.md for the full operator runbook.
IT_AGENT_GRAPH_LIVE_READONLY=false
# Non-secret identifiers (safe to set; these are NOT secrets):
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# --- Azure Key Vault (secret stays in the vault; only a REFERENCE lives here) ---
# The client SECRET value is NEVER stored in env or source. Provide only the
# Key Vault URL and the secret's REFERENCE name/URI; the value is fetched at
# runtime via managed identity (@azure/identity DefaultAzureCredential).
# AZURE_KEY_VAULT_URL=https://<your-vault>.vault.azure.net
# GRAPH_CLIENT_SECRET_KEYVAULT_REF=watson-graph-client-secret
# Optional: user-assigned managed identity client id for Key Vault access.
# Leave unset to use the system-assigned / workload identity. This is NOT the
# Graph app (GRAPH_CLIENT_ID) and is NOT a secret.
# AZURE_MANAGED_IDENTITY_CLIENT_ID=

# --- OTHER FUTURE INTEGRATIONS (all disabled in this build) -
# INTUNE_ENABLED=false
# NINJAONE_ENABLED=false
# ATERA_ENABLED=false
